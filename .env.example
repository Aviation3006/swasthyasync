# =============================================================================
# SWASTHYASYNC - PUBLIC DEPLOYMENT ENVIRONMENT CONFIGURATION (.env.example)
# =============================================================================

# Application Deployment Mode ('production' | 'development')
VITE_APP_MODE=production

# -----------------------------------------------------------------------------
# Optional AI Services: Google Gemini Multimodal API Key (Server-Side Only)
# -----------------------------------------------------------------------------
# Used server-side for Gemini Cloud TTS, live medical report simplification, and symptom triage.
# NOTE: The GEMINI_API_KEY is NEVER bundled into the frontend or exposed to clients.
# Set this in your Vercel Project Environment Variables or server .env file.
GEMINI_API_KEY=your_server_side_key_here

# -----------------------------------------------------------------------------
# Optional Cloud Database: Supabase Configuration
# -----------------------------------------------------------------------------
# NOTE: If omitted or empty, SwasthyaSync uses its robust in-browser reactive
# StorageStore (localStorage) with all demo accounts, seeded hospital reviews,
# and appointments preloaded for flawless demo presentations.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
